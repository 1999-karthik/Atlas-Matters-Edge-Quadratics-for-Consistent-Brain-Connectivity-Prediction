{
  "model": "edgequadd",
  "dataset": "adni_ward100",
  "hp": {
    "layers": 6,
    "dropout": 0.6,
    "droppath": 0.05,
    "cluster_num": 8,
    "activation": "relu",
    "rank": 4,
    "encoder_hidden": 128,
    "use_layer_norm": true,
    "quadratic_aspp_rates": [
      1,
      3,
      6
    ],
    "frontend": "none"
  },
  "train": {
    "lr": 0.007879195224529404,
    "weight_decay": 9.874055897480266e-07,
    "batch_size": 16,
    "epochs": 200,
    "optimizer": "adam",
    "schedule": "cosine",
    "grad_clip": 1.0,
    "warmup_epochs": 0,
    "lr_final_ratio": 0.5,
    "mixup": "hard"
  }
}
