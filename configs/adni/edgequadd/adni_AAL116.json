{
  "model": "edgequadd",
  "dataset": "adni_AAL116",
  "hp": {
    "layers": 6,
    "dropout": 0.2,
    "droppath": 0.1,
    "cluster_num": 4,
    "activation": "gelu",
    "rank": 8,
    "quad_lr_mult": 2.0,
    "alpha_init": 1.0,
    "encoder_hidden": 16,
    "use_layer_norm": false,
    "quadratic_aspp_rates": [
      1,
      2,
      4,
      8
    ],
    "frontend": "cnn",
    "cnncorr_aspp_rates": [
      1,
      2,
      4
    ],
    "cnncorr_base_ch": 64,
    "cnncorr_norm": "gn",
    "cnncorr_diag_mode": "channel"
  },
  "train": {
    "lr": 0.003896638223217113,
    "weight_decay": 0.003874410747777844,
    "batch_size": 16,
    "epochs": 50,
    "optimizer": "adam",
    "schedule": "warmup_cosine",
    "grad_clip": 1.0,
    "warmup_epochs": 10,
    "lr_final_ratio": 0.1,
    "mixup": "none",
    "selection": "val_loss"
  }
}
