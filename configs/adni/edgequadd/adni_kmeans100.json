{
  "model": "edgequadd",
  "dataset": "adni_kmeans100",
  "hp": {
    "layers": 5,
    "dropout": 0.2,
    "droppath": 0.0,
    "cluster_num": 2,
    "activation": "elu",
    "rank": 3,
    "quad_lr_mult": 1.0,
    "alpha_init": 1.0,
    "encoder_hidden": 16,
    "use_layer_norm": false,
    "quadratic_aspp_rates": [
      1,
      2,
      4
    ],
    "frontend": "none"
  },
  "train": {
    "lr": 0.000647307053646643,
    "weight_decay": 0.0005359139175019421,
    "batch_size": 4,
    "epochs": 300,
    "optimizer": "adam",
    "schedule": "cosine",
    "grad_clip": 1.0,
    "warmup_epochs": 0,
    "lr_final_ratio": 1.0,
    "mixup": "hard",
    "selection": "val_loss"
  }
}
