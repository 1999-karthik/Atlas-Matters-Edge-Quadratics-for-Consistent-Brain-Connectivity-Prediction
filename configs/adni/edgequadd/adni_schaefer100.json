{
  "model": "edgequadd",
  "dataset": "adni_schaefer100",
  "hp": {
    "layers": 2,
    "dropout": 0.2,
    "droppath": 0.3,
    "cluster_num": 16,
    "activation": "elu",
    "rank": 2,
    "quad_lr_mult": 2.0,
    "alpha_init": 0.0,
    "encoder_hidden": 64,
    "use_layer_norm": true,
    "quadratic_aspp_rates": [
      1,
      2,
      4
    ],
    "frontend": "none"
  },
  "train": {
    "lr": 0.007350600536771366,
    "weight_decay": 0.0007227896699499728,
    "batch_size": 16,
    "epochs": 400,
    "optimizer": "adam",
    "schedule": "warmup_cosine",
    "grad_clip": 1.0,
    "warmup_epochs": 5,
    "lr_final_ratio": 0.1,
    "mixup": "hard",
    "selection": "val_loss"
  }
}
