{
  "model": "edgequadd",
  "dataset": "abide_ward100",
  "hp": {
    "layers": 2,
    "dropout": 0.9,
    "droppath": 0.1,
    "cluster_num": 8,
    "activation": "leaky_relu",
    "rank": 3,
    "quad_lr_mult": 2.0,
    "alpha_init": 0.5,
    "encoder_hidden": 128,
    "use_layer_norm": false,
    "quadratic_aspp_rates": [
      1,
      3,
      6
    ],
    "frontend": "none"
  },
  "train": {
    "lr": 2.0871622887085912e-05,
    "weight_decay": 0.0010060949766548222,
    "batch_size": 8,
    "epochs": 100,
    "optimizer": "adam",
    "schedule": "cosine",
    "grad_clip": 0.0,
    "warmup_epochs": 0,
    "lr_final_ratio": 0.01,
    "mixup": "hard",
    "selection": "val_loss"
  }
}
