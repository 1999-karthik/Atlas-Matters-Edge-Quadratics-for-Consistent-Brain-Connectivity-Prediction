{
  "model": "edgequadd",
  "dataset": "abide_schaefer100",
  "hp": {
    "layers": 1,
    "dropout": 0.2,
    "droppath": 0.2,
    "cluster_num": 16,
    "activation": "gelu",
    "rank": 16,
    "quad_lr_mult": 1.0,
    "alpha_init": 0.0,
    "encoder_hidden": 128,
    "use_layer_norm": false,
    "quadratic_aspp_rates": [
      1,
      2,
      4
    ],
    "frontend": "none"
  },
  "train": {
    "lr": 3.5007547581706267e-06,
    "weight_decay": 0.00022482735485643217,
    "batch_size": 8,
    "epochs": 200,
    "optimizer": "adamw",
    "schedule": "warmup_cosine",
    "grad_clip": 1.0,
    "warmup_epochs": 10,
    "lr_final_ratio": 0.1,
    "mixup": "hard",
    "selection": "val_loss"
  }
}
