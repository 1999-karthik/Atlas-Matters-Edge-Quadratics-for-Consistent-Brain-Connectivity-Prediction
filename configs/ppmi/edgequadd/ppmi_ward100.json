{
  "model": "edgequadd",
  "dataset": "ppmi_ward100",
  "hp": {
    "layers": 6,
    "dropout": 0.1,
    "droppath": 0.1,
    "cluster_num": 2,
    "activation": "gelu",
    "rank": 1,
    "quad_lr_mult": 0.5,
    "alpha_init": 1.0,
    "encoder_hidden": 64,
    "use_layer_norm": false,
    "quadratic_aspp_rates": [
      1,
      3,
      6
    ],
    "frontend": "none"
  },
  "train": {
    "lr": 0.004531930391475832,
    "weight_decay": 1.0104703843822865e-05,
    "batch_size": 64,
    "epochs": 400,
    "optimizer": "adam",
    "schedule": "warmup_cosine",
    "grad_clip": 5.0,
    "warmup_epochs": 5,
    "lr_final_ratio": 0.1,
    "mixup": "none",
    "selection": "val_auc"
  }
}
