{
  "model": "edgequadd",
  "dataset": "ppmi_schaefer100",
  "hp": {
    "layers": 6,
    "dropout": 0.2,
    "droppath": 0.0,
    "cluster_num": 2,
    "activation": "relu",
    "rank": 6,
    "quad_lr_mult": 0.25,
    "alpha_init": 0.5,
    "encoder_hidden": 128,
    "use_layer_norm": true,
    "quadratic_aspp_rates": [
      1,
      2,
      4,
      8
    ],
    "frontend": "none"
  },
  "train": {
    "lr": 0.0031396321452289377,
    "weight_decay": 6.474730129265686e-06,
    "batch_size": 8,
    "epochs": 300,
    "optimizer": "adam",
    "schedule": "cosine",
    "grad_clip": 5.0,
    "warmup_epochs": 0,
    "lr_final_ratio": 1.0,
    "mixup": "hard",
    "selection": "val_auc"
  }
}
