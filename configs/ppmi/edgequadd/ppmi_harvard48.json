{
  "model": "edgequadd",
  "dataset": "ppmi_harvard48",
  "hp": {
    "layers": 4,
    "dropout": 0.30000000000000004,
    "droppath": 0.1,
    "cluster_num": 32,
    "activation": "leaky_relu",
    "rank": 2,
    "quad_lr_mult": 2.0,
    "alpha_init": 1.0,
    "encoder_hidden": 16,
    "use_layer_norm": false,
    "quadratic_aspp_rates": [
      1,
      2
    ],
    "frontend": "cnn",
    "cnncorr_aspp_rates": [
      1,
      2,
      4
    ],
    "cnncorr_base_ch": 32,
    "cnncorr_norm": "gn",
    "cnncorr_diag_mode": "zero"
  },
  "train": {
    "lr": 0.005801006466186754,
    "weight_decay": 8.575623496500638e-05,
    "batch_size": 16,
    "epochs": 300,
    "optimizer": "adamw",
    "schedule": "cosine",
    "grad_clip": 5.0,
    "warmup_epochs": 0,
    "lr_final_ratio": 1.0,
    "mixup": "hard",
    "selection": "val_auc"
  }
}
