{
  "model": "edgequadd",
  "dataset": "ppmi_kmeans100",
  "hp": {
    "layers": 5,
    "dropout": 0.6,
    "droppath": 0.1,
    "cluster_num": 2,
    "activation": "leaky_relu",
    "rank": 1,
    "quad_lr_mult": 2.0,
    "alpha_init": 0.5,
    "encoder_hidden": 128,
    "use_layer_norm": true,
    "quadratic_aspp_rates": [
      1,
      2
    ],
    "frontend": "none"
  },
  "train": {
    "lr": 0.0015109330261674466,
    "weight_decay": 0.00010371045954247209,
    "batch_size": 32,
    "epochs": 300,
    "optimizer": "adam",
    "schedule": "cosine",
    "grad_clip": 0.0,
    "warmup_epochs": 0,
    "lr_final_ratio": 0.5,
    "mixup": "hard",
    "selection": "val_auc"
  }
}
